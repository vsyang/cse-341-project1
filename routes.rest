// LOCALHOST 
### Get all contacts
GET http://localhost:3000/contacts

### Get a single contact by ID
GET http://localhost:3000/contacts/6909795c0bae1a1b5db6934b

### Create a new contact
POST http://localhost:3000/contacts HTTP/1.1
Content-Type: application/json  

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "jdoe@test.com",
    "favoriteColor": "purple",
    "birthday": "January 1, 1990"
}

### Update an existing contact by ID
PUT http://localhost:3000/contacts/6909805c3a0b7a8818261983 HTTP/1.1
Content-Type: application/json  

{
    "firstName": "Jane",
    "lastName": "Doe",
    "email": "test2@test.com",
    "favoriteColor": "blue",
    "birthday": "February 2, 1992"
}   

### Delete a contact by ID
DELETE http://localhost:3000/contacts/6909805c3a0b7a8818261983 
